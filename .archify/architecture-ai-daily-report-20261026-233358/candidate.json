  "cards": [
    {
      "dot": "cyan",
      "title": "触发与调度",
      "items": [
        "计划任务按 -Kind daily / collect / parse / health 注册，任务名带后缀",
        "health 任务在 11:00、23:00 运行 health_notify.ps1，写 log_dir/health-YYYY-MM-DD.json",
        "异常时用 NotifyIcon 弹桌面通知，执行失败与通知失败分开记录"
      ]
    },
    {
      "dot": "emerald",
      "title": "归档与解析",
      "items": [
        "data/archive 的 schema v1 保存对象、版本、抽取、变更与证据引用",
        "collect 只复制变更并入队；parse 以 worker 协议 v4 调 office_parser / pdf_parser",
        "scan 来源由 scanner_core 在进程内调度同一解析 worker 池"
      ]
    },
    {
      "dot": "violet",
      "title": "报告生成",
      "items": [
        "personal profile 必须用 archive 来源：先冻结输入 v5，再按计划 v6 生成",
        "选择比较目标日前最后一次观察与当日最后一次观察，每侧上限 5,000 件",
        "先发布依据附件再发布正文；reports.sqlite3 记录运行、发布指纹与模型调用审计"
      ]
    },
    {
      "dot": "amber",
      "title": "预算与约束",
      "items": [
        "personal 在 270 秒停止发起新操作，300 秒内收尾",
        "采集与排空各限 120 秒；材料保留 7 天 / 1 GiB",
        "不设累计模型调用、token 或费用额度；失败一次即止并留审计"
      ]
    },
    {
      "dot": "rose",
      "title": "周期汇总 weekly / monthly",
      "items": [
        "只接受 --source db：读区间内已发布的归档日报，archive 来源直接拒绝",
        "缺失日期写入 gaps，质量降为 partial；计划 v3 用 weekly / monthly 模板",
        "正文经 Publisher.period_path 写 data/reports/weekly|monthly/<label>.md"
      ]
    },
    {
      "dot": "slate",
      "title": "运维与巡检命令",
      "items": [
        "doctor --strict 校验配置、模板、库、worker 与 PDFium，不联网",
        "list / search / runs / repair-output 只读核对报告库与输出文件",
        "archive stats / coverage / ocr / backfill 读归档证据；cleanup / backup 按授权执行且不触发模型调用"
      ]
    }
  ]
}
