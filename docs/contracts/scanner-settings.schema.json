{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scanner-settings.schema.json",
  "title": "ScannerSettings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "allowed_extensions": {
      "$ref": "#/$defs/extensionArray"
    },
    "ignored_patterns": {
      "$ref": "#/$defs/stringArray"
    },
    "excluded_dirs": {
      "$ref": "#/$defs/stringArray"
    },
    "max_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "max_file_size_mb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "discovery_timeout_seconds": {
      "$ref": "#/$defs/timeoutSeconds"
    },
    "file_timeout_seconds": {
      "$ref": "#/$defs/timeoutSeconds"
    },
    "file_timeout_by_extension": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/extension"
      },
      "additionalProperties": {
        "$ref": "#/$defs/timeoutSeconds"
      }
    },
    "total_max_chars": {
      "$ref": "#/$defs/charBudget"
    },
    "fallback_after_timeout": {
      "type": "boolean"
    },
    "legacy_office_enabled": {
      "type": "boolean"
    },
    "pptx_include_notes": {
      "type": "boolean"
    },
    "direct_text_max_bytes": {
      "$ref": "#/$defs/readBudget"
    },
    "direct_text_read_bytes": {
      "$ref": "#/$defs/readBudget"
    },
    "log_tail_read_bytes": {
      "$ref": "#/$defs/readBudget"
    },
    "text_excerpt_max_chars": {
      "$ref": "#/$defs/charBudget"
    },
    "excel_max_rows": {
      "$ref": "#/$defs/rowBudget"
    },
    "pdf_max_pages": {
      "$ref": "#/$defs/pdfPageBudget"
    },
    "text_max_chars": {
      "$ref": "#/$defs/charBudget"
    },
    "excel_max_sheets": {
      "$ref": "#/$defs/excelSheetBudget"
    },
    "excel_max_columns": {
      "$ref": "#/$defs/columnBudget"
    },
    "docx_max_paragraphs": {
      "$ref": "#/$defs/docxParagraphBudget"
    },
    "docx_max_tables": {
      "$ref": "#/$defs/documentCollectionBudget"
    },
    "docx_table_max_rows": {
      "$ref": "#/$defs/rowBudget"
    },
    "docx_table_max_cols": {
      "$ref": "#/$defs/columnBudget"
    },
    "pptx_max_slides": {
      "$ref": "#/$defs/documentCollectionBudget"
    },
    "document_excerpt_max_chars": {
      "$ref": "#/$defs/charBudget"
    },
    "summary_excel_max_rows": {
      "$ref": "#/$defs/rowBudget"
    },
    "summary_pdf_max_pages": {
      "$ref": "#/$defs/pdfPageBudget"
    },
    "summary_text_max_chars": {
      "$ref": "#/$defs/charBudget"
    },
    "summary_excel_max_sheets": {
      "$ref": "#/$defs/excelSheetBudget"
    },
    "summary_excel_max_columns": {
      "$ref": "#/$defs/columnBudget"
    },
    "summary_docx_max_paragraphs": {
      "$ref": "#/$defs/docxParagraphBudget"
    },
    "summary_docx_max_tables": {
      "$ref": "#/$defs/documentCollectionBudget"
    },
    "summary_docx_table_max_rows": {
      "$ref": "#/$defs/rowBudget"
    },
    "summary_docx_table_max_cols": {
      "$ref": "#/$defs/columnBudget"
    },
    "summary_pptx_max_slides": {
      "$ref": "#/$defs/documentCollectionBudget"
    },
    "summary_document_excerpt_max_chars": {
      "$ref": "#/$defs/charBudget"
    },
    "max_candidate_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "max_pdf_text_extractions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "max_total_pdf_classification_pages": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "pdf_classification_timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    },
    "total_deadline_ms": {
      "type": "integer",
      "minimum": 5000,
      "maximum": 3600000
    },
    "worker_max_requests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "worker_idle_ttl_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 600000
    },
    "worker_rss_limit_bytes": {
      "type": "integer",
      "minimum": 67108864,
      "maximum": 8589934592
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "extension": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^\\.[^A-Z\\\\/:\\u0000]{1,31}$"
    },
    "extensionArray": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/extension"
      }
    },
    "stringArray": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "readBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "charBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "pdfPageBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "excelSheetBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "rowBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "columnBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "docxParagraphBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "documentCollectionBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    }
  }
}
