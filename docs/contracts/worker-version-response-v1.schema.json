{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-version-response-v1.schema.json",
  "title": "WorkerVersionResponse v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "protocol_version",
    "worker_kind",
    "worker_contract_version",
    "worker_version",
    "worker_build",
    "supported_backends",
    "supported_extensions"
  ],
  "properties": {
    "contract": {
      "const": "ai_daily_worker"
    },
    "protocol_version": {
      "const": 1
    },
    "worker_kind": {
      "type": "string",
      "enum": [
        "office",
        "python_document"
      ]
    },
    "worker_contract_version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "worker_version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "worker_build": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "supported_backends": {
      "$ref": "#/$defs/stringSet"
    },
    "supported_extensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/extension"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "extension": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^\\.[^A-Z\\\\/:\\u0000]{1,31}$"
    }
  }
}
