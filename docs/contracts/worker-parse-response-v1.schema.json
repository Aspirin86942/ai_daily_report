{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-parse-response-v1.schema.json",
  "title": "WorkerParseResponse v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "protocol_version",
    "request_id",
    "status",
    "file_path",
    "file_type",
    "content",
    "parser_backend",
    "worker_lane",
    "truncated",
    "warnings",
    "error",
    "duration_ms",
    "worker_contract_version",
    "worker_version",
    "worker_build",
    "observed_source_version"
  ],
  "properties": {
    "contract": {
      "const": "ai_daily_worker"
    },
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "$ref": "#/$defs/requestId"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error"
      ]
    },
    "file_path": {
      "$ref": "#/$defs/absolutePath"
    },
    "file_type": {
      "$ref": "#/$defs/extension"
    },
    "content": {
      "type": "string"
    },
    "parser_backend": {
      "type": "string",
      "enum": [
        "rust_office_oxide_v1",
        "rust_xlsx_bounded_v1",
        "python_office_v1",
        "pdf_text_v1",
        "python_sharepoint_text_v1"
      ]
    },
    "worker_lane": {
      "type": "string",
      "enum": [
        "rust_office_process",
        "python_document_process"
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "diagnostic-v1.schema.json"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "diagnostic-v1.schema.json"
        }
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "worker_contract_version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "worker_version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "worker_build": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "observed_source_version": {
      "$ref": "#/$defs/sourceVersion"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "const": ""
          },
          "error": {
            "$ref": "diagnostic-v1.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "parser_backend": {
            "const": "rust_office_oxide_v1"
          }
        }
      },
      "then": {
        "properties": {
          "file_type": {
            "enum": [
              ".docx",
              ".pptx"
            ]
          },
          "worker_lane": {
            "const": "rust_office_process"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "parser_backend": {
            "const": "rust_xlsx_bounded_v1"
          }
        }
      },
      "then": {
        "properties": {
          "file_type": {
            "const": ".xlsx"
          },
          "worker_lane": {
            "const": "rust_office_process"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "parser_backend": {
            "const": "python_office_v1"
          }
        }
      },
      "then": {
        "properties": {
          "file_type": {
            "enum": [
              ".docx",
              ".pptx",
              ".xls",
              ".xlsx"
            ]
          },
          "worker_lane": {
            "const": "python_document_process"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "parser_backend": {
            "const": "pdf_text_v1"
          }
        }
      },
      "then": {
        "properties": {
          "file_type": {
            "const": ".pdf"
          },
          "worker_lane": {
            "const": "python_document_process"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "parser_backend": {
            "const": "python_sharepoint_text_v1"
          }
        }
      },
      "then": {
        "properties": {
          "file_type": {
            "enum": [
              ".doc",
              ".ppt"
            ]
          },
          "worker_lane": {
            "const": "python_document_process"
          }
        }
      }
    }
  ],
  "$defs": {
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32767,
      "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\|/)"
    },
    "extension": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^\\.[^A-Z\\\\/:\\u0000]{1,31}$"
    },
    "sourceVersion": {
      "type": "string",
      "pattern": "^mtime_ns=[0-9]+:size=[0-9]+$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  }
}
