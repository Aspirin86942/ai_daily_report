{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doctor-response-v1.schema.json",
  "title": "DoctorResponse v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "protocol_version",
    "request_id",
    "status",
    "engine_version",
    "engine_build",
    "checks",
    "warnings",
    "error"
  ],
  "properties": {
    "contract": {
      "const": "ai_daily_context"
    },
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "$ref": "#/$defs/requestId"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "error"
      ]
    },
    "engine_version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "engine_build": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "checks": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/doctorCheck"
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "diagnostic-v1.schema.json"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "diagnostic-v1.schema.json"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "partial"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "warnings": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "$ref": "diagnostic-v1.schema.json"
          }
        }
      }
    }
  ],
  "$defs": {
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "doctorCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "message"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "warning",
            "error"
          ]
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
