{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalized-scanner-settings.schema.json",
  "title": "NormalizedScannerSettings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_mode",
    "discovery",
    "execution",
    "parse",
    "context",
    "admission_policy_version",
    "classifier_policy_version",
    "max_candidate_files",
    "max_pdf_text_extractions",
    "max_total_pdf_classification_pages",
    "pdf_classification_timeout_ms",
    "total_deadline_ms",
    "worker_max_requests",
    "worker_idle_ttl_ms",
    "worker_rss_limit_bytes"
  ],
  "properties": {
    "report_mode": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ]
    },
    "discovery": {
      "$ref": "#/$defs/discovery"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "parse": {
      "$ref": "#/$defs/parse"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "admission_policy_version": {
      "const": "budget_admission_v2"
    },
    "classifier_policy_version": {
      "const": "pdf_text_presence_v1"
    },
    "max_candidate_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "max_pdf_text_extractions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "max_total_pdf_classification_pages": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "pdf_classification_timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    },
    "total_deadline_ms": {
      "type": "integer",
      "minimum": 5000,
      "maximum": 3600000
    },
    "worker_max_requests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "worker_idle_ttl_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 600000
    },
    "worker_rss_limit_bytes": {
      "type": "integer",
      "minimum": 67108864,
      "maximum": 8589934592
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "report_mode": {
            "const": "daily"
          }
        }
      },
      "then": {
        "properties": {
          "context": {
            "properties": {
              "profile_name": {
                "const": "daily_balanced_v1"
              },
              "global_max_chars": { "const": 500000 },
              "per_file_max_chars": { "const": 100000 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "report_mode": {
            "const": "weekly"
          }
        }
      },
      "then": {
        "properties": {
          "context": {
            "properties": {
              "profile_name": {
                "const": "weekly_balanced_v1"
              },
              "global_max_chars": { "const": 500000 },
              "per_file_max_chars": { "const": 100000 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "report_mode": {
            "const": "monthly"
          }
        }
      },
      "then": {
        "properties": {
          "context": {
            "properties": {
              "profile_name": {
                "const": "monthly_balanced_v1"
              },
              "global_max_chars": { "const": 500000 },
              "per_file_max_chars": { "const": 100000 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "extension": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^\\.[^A-Z\\\\/:\\u0000]{1,31}$"
    },
    "extensionArray": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/extension"
      }
    },
    "stringArray": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_extensions",
        "ignored_patterns",
        "excluded_dirs"
      ],
      "properties": {
        "allowed_extensions": {
          "$ref": "#/$defs/extensionArray"
        },
        "ignored_patterns": {
          "$ref": "#/$defs/stringArray"
        },
        "excluded_dirs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_workers",
        "max_file_size_bytes",
        "discovery_timeout_ms",
        "file_timeout_ms",
        "file_timeout_by_extension_ms"
      ],
      "properties": {
        "max_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_file_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "discovery_timeout_ms": {
          "$ref": "#/$defs/timeoutMs"
        },
        "file_timeout_ms": {
          "$ref": "#/$defs/timeoutMs"
        },
        "file_timeout_by_extension_ms": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "$ref": "#/$defs/extension"
          },
          "additionalProperties": {
            "$ref": "#/$defs/timeoutMs"
          }
        }
      }
    },
    "parse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_max_chars",
        "text",
        "office",
        "pdf"
      ],
      "properties": {
        "aggregate_max_chars": {
          "$ref": "#/$defs/charBudget"
        },
        "text": {
          "$ref": "#/$defs/textParse"
        },
        "office": {
          "$ref": "#/$defs/officeParse"
        },
        "pdf": {
          "$ref": "#/$defs/pdfParse"
        }
      }
    },
    "textParse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "read_head_bytes",
        "read_tail_bytes",
        "max_chars",
        "excerpt_max_chars"
      ],
      "properties": {
        "backend": {
          "const": "light_text_v2"
        },
        "read_head_bytes": {
          "$ref": "#/$defs/readBudget"
        },
        "read_tail_bytes": {
          "$ref": "#/$defs/readBudget"
        },
        "max_chars": {
          "$ref": "#/$defs/charBudget"
        },
        "excerpt_max_chars": {
          "$ref": "#/$defs/charBudget"
        }
      }
    },
    "officeParse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_backend",
        "fallback_enabled",
        "fallback_order",
        "fallback_after_timeout",
        "fallback_policy_version",
        "legacy_extensions_enabled",
        "excel_max_sheets",
        "excel_max_rows",
        "excel_max_columns",
        "docx_max_paragraphs",
        "docx_max_tables",
        "docx_table_max_rows",
        "docx_table_max_cols",
        "pptx_max_slides",
        "pptx_include_notes",
        "document_excerpt_max_chars"
      ],
      "properties": {
        "primary_backend": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fallback_enabled": {
          "type": "boolean"
        },
        "fallback_order": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "python_office_v2",
              "python_sharepoint_text_v2"
            ]
          }
        },
        "fallback_after_timeout": {
          "type": "boolean"
        },
        "fallback_policy_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "legacy_extensions_enabled": {
          "type": "boolean"
        },
        "excel_max_sheets": {
          "$ref": "#/$defs/excelSheetBudget"
        },
        "excel_max_rows": {
          "$ref": "#/$defs/rowBudget"
        },
        "excel_max_columns": {
          "$ref": "#/$defs/columnBudget"
        },
        "docx_max_paragraphs": {
          "$ref": "#/$defs/docxParagraphBudget"
        },
        "docx_max_tables": {
          "$ref": "#/$defs/documentCollectionBudget"
        },
        "docx_table_max_rows": {
          "$ref": "#/$defs/rowBudget"
        },
        "docx_table_max_cols": {
          "$ref": "#/$defs/columnBudget"
        },
        "pptx_max_slides": {
          "$ref": "#/$defs/documentCollectionBudget"
        },
        "pptx_include_notes": {
          "type": "boolean"
        },
        "document_excerpt_max_chars": {
          "$ref": "#/$defs/charBudget"
        }
      }
    },
    "pdfParse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "max_pages",
        "excerpt_max_chars"
      ],
      "properties": {
        "backend": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "max_pages": {
          "$ref": "#/$defs/pdfPageBudget"
        },
        "excerpt_max_chars": {
          "$ref": "#/$defs/charBudget"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_name",
        "global_max_chars",
        "per_file_max_chars",
        "small_file_max_bytes",
        "medium_file_max_bytes",
        "large_file_max_bytes",
        "priority_policy_version",
        "compression_policy_version"
      ],
      "properties": {
        "profile_name": {
          "type": "string",
          "enum": [
            "daily_balanced_v1",
            "weekly_balanced_v1",
            "monthly_balanced_v1"
          ]
        },
        "global_max_chars": {
          "$ref": "#/$defs/charBudget"
        },
        "per_file_max_chars": {
          "$ref": "#/$defs/charBudget"
        },
        "small_file_max_bytes": {
          "const": 65536
        },
        "medium_file_max_bytes": {
          "const": 1048576
        },
        "large_file_max_bytes": {
          "const": 10485760
        },
        "priority_policy_version": {
          "const": "budget_nominal_v2"
        },
        "compression_policy_version": {
          "const": "markdown_context_v2"
        }
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 3600000
    },
    "readBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "charBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "pdfPageBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "excelSheetBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "rowBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "columnBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "docxParagraphBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "documentCollectionBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    }
  }
}
