{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transport-error-v1.schema.json",
  "title": "TransportErrorResponse v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "protocol_version",
    "status",
    "error"
  ],
  "properties": {
    "contract": {
      "const": "ai_daily_transport"
    },
    "protocol_version": {
      "const": 1
    },
    "status": {
      "const": "error"
    },
    "error": {
      "allOf": [
        {
          "$ref": "diagnostic-v1.schema.json"
        },
        {
          "properties": {
            "error_code": {
              "const": "INVALID_REQUEST"
            },
            "stage": {
              "const": "request"
            },
            "file_path": {
              "const": null
            },
            "backend": {
              "const": null
            }
          }
        }
      ]
    }
  }
}
