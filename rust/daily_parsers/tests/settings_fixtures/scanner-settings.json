{
  "pdf_image_ocr": {
    "enabled": false,
    "max_files": 1,
    "max_pages": 3
  },
  "allowed_extensions": [
    ".xlsx",
    ".xls",
    ".pptx",
    ".pdf",
    ".txt",
    ".md",
    ".docx",
    ".csv",
    ".json",
    ".log"
  ],
  "ignored_patterns": [
    "~$*",
    "*.tmp",
    "*备份*.xlsx"
  ],
  "excluded_dirs": [],
  "follow_symlinks": false,
  "cloud_files_policy": "local_only",
  "max_workers": 4,
  "max_file_size_mb": 50,
  "discovery_timeout_seconds": 30,
  "file_timeout_seconds": 30,
  "file_timeout_by_extension": {
    ".pdf": 45,
    ".xls": 60,
    ".xlsx": 60
  },
  "total_max_chars": 50000,
  "context_max_chars": 180000,
  "excerpt_priority_paths": [
    "samples/priority.txt"
  ],
  "legacy_office_enabled": false,
  "pptx_include_notes": true,
  "direct_text_max_bytes": 262144,
  "direct_text_read_bytes": 262144,
  "log_tail_read_bytes": 262144,
  "text_excerpt_max_chars": 6000,
  "excel_max_rows": 50,
  "pdf_max_pages": 5,
  "text_max_chars": 6000,
  "csv_encodings": [
    "utf-8",
    "utf-8-sig",
    "gb18030"
  ],
  "excel_max_sheets": 5,
  "excel_max_columns": 20,
  "docx_max_paragraphs": 200,
  "docx_max_tables": 20,
  "docx_table_max_rows": 50,
  "docx_table_max_cols": 12,
  "pptx_max_slides": 50,
  "document_excerpt_max_chars": 6000,
  "summary_excel_max_rows": 10,
  "summary_pdf_max_pages": 2,
  "summary_text_max_chars": 2000,
  "summary_excel_max_sheets": 2,
  "summary_excel_max_columns": 12,
  "summary_docx_max_paragraphs": 80,
  "summary_docx_max_tables": 8,
  "summary_docx_table_max_rows": 20,
  "summary_docx_table_max_cols": 8,
  "summary_pptx_max_slides": 15,
  "summary_document_excerpt_max_chars": 2000,
  "max_candidate_files": 96,
  "max_pdf_text_extractions": 8,
  "max_total_pdf_classification_pages": 80,
  "pdf_classification_timeout_ms": 2000,
  "total_deadline_ms": 25000,
  "worker_max_requests": 128,
  "worker_idle_ttl_ms": 30000,
  "worker_rss_limit_bytes": 536870912
}
